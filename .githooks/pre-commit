#!/bin/sh
# Reminder, not an enforcer: warns when a commit touches a source that
# feeds one of man/figures/demo-deck-*.png (or the downloadable
# man/figures/demo-deck.pptx alongside them), but the commit doesn't
# also touch that asset group. Mirrors ../quartifyr's own
# .githooks/pre-commit for the same reason -- these are committed,
# rendered artifacts, not something regenerated at build/check time, so
# nothing else catches them drifting from the source that produced them
# (see the "demo-deck-pk-summary.png/demo-deck-concentration-time.png
# went stale" incident this hook was added for: table_styles chrome and
# the reportifyr footer both landed in the engine and demo-deck's own
# YAML without the screenshots or the downloadable .pptx ever being
# regenerated against them).
#
# Skip with SKIP_DOCS_ASSET_CHECK=1 or `git commit --no-verify` for
# changes that don't actually alter what's on screen (e.g. a comment or
# a refactor with identical composed output) -- this can't tell the
# difference, it only knows the source file changed.
#
# Regenerate the asset group with:
#   uv run deckifyr build examples/demo-deck/presentation.yaml
#   soffice --headless --convert-to pdf --outdir /tmp examples/demo-deck/build/demo-deck.pptx
#   # rasterize each PDF page at 110dpi (matches the existing PNGs'
#   # 1467x825 -- see e.g. `python3 -c "import fitz; ..."` using
#   # page.get_pixmap(dpi=110)) into man/figures/demo-deck-{title,
#   # concentration-time,pk-interpretation,pk-summary,closing}.png, in
#   # slide order -- building this deck needs the external `quarto`
#   # binary and Rscript on PATH (see examples/demo-deck/README.md)
#   cp examples/demo-deck/build/demo-deck.pptx man/figures/demo-deck.pptx
#
# man/figures/demo-deck-corner-tr-example.png is a supplementary asset,
# not part of the group above -- it renders status_indicator: corner-tr
# from a throwaway copy of the project (presentation.yaml's own
# status_indicator: watermark is untouched), to show that alternative
# placement actually composed. Only regenerate it if design.yaml's
# furniture.status.corner_tr itself changes; see
# examples/demo-deck/README.md's own "Where the background and
# watermark come from" section for the exact reproduction steps.
#
# man/figures/web-app-editor.png/web-app-no-project.png/web-app-
# furniture.png/web-app-layout-tab.png/web-app-add-slide.png/
# web-app-add-element.png/web-app-build-preview.png/
# web-app-color-swatch.png (used in vignettes/articles/web-app.Rmd) are
# a second, independent asset group, checked separately below -- real
# screenshots of the web editor (inst/python/deckifyr/web/static/'s
# built frontend, served by a real `deckifyr serve`), not something a
# build step regenerates. Regenerate with Playwright against a real
# running server, e.g.:
#   npm --prefix web run build
#   # use a scratch copy of examples/demo-deck, not the tracked one --
#   # the "Show furniture"/"Deck-wide" toggles write real PUTs/PATCHes
#   # back to presentation.yaml (see the "toggled the tracked demo-deck
#   # example's watermark off via a live deck_serve() session" incident
#   # this note exists because of)
#   cp -r examples/demo-deck /tmp/demo-scratch
#   uv run deckifyr serve --project /tmp/demo-scratch --port 8330 &
#   # screenshot http://127.0.0.1:8330/ at 1400x900, zoom set to 75% via
#   # the toolbar's own <select> so a 13.333in-wide slide fits the
#   # viewport, "Show furniture" left unchecked (the default) -- save as
#   # man/figures/web-app-editor.png; check "Show furniture" and
#   # re-screenshot for man/figures/web-app-furniture.png
#   # repeat against an empty project directory (no presentation.yaml)
#   # for man/figures/web-app-no-project.png
#   # in the slide list, toggle Slides/Layouts to Layouts and select a
#   # layout with real zones (e.g. plot-with-note in demo-deck), for
#   # man/figures/web-app-layout-tab.png (filename predates the mode
#   # toggle's own issue #30 redesign -- kept as-is, not renamed, to
#   # avoid churning this hook/CONTRIBUTING.md/the vignette's <img> src
#   # for a cosmetic rename alone)
#   # click "+ Add slide" in the slide list for
#   # man/figures/web-app-add-slide.png
#   # back in Slides mode, select an ordinary slide and click "+ Add
#   # element" in the Elements sidebar (issue #31) for
#   # man/figures/web-app-add-element.png
#   # open the Build tab (editable output path + Preview section -- a
#   # real render if this machine has soffice, otherwise the "LibreOffice
#   # not installed" message is still a real, useful screenshot of that
#   # state) for man/figures/web-app-build-preview.png
#   # open the Config tab's Form view on design.yaml, scroll to a
#   # `colors` entry (e.g. colors.primary) for
#   # man/figures/web-app-color-swatch.png
# See the "Rebuilding the web frontend" section of this file for the
# frontend build step itself.
#
# Add a case here whenever a new rendered-doc-asset group is added,
# alongside a matching note in CONTRIBUTING.md -- this is the
# machine-checkable half of the same rule, kept next to it so they're
# easy to update together.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# SKIP_DOCS_ASSET_CHECK only silences the rendered-doc-asset *reminders*
# below (demo-deck-*.png/.pptx and the web-app-*.png screenshots) -- it
# must not also silence the web/ test-and-rebuild enforcement further
# down, which has its own separate SKIP_WEB_CHECKS escape hatch. An
# earlier version of this hook exited unconditionally on
# SKIP_DOCS_ASSET_CHECK before reaching that block at all, which quietly
# contradicted that block's own comment claiming it "always blocks" --
# never actually true whenever a developer had SKIP_DOCS_ASSET_CHECK set
# for an unrelated demo-deck edit.
#
# The demo-deck/screenshot reminder *detection* runs here, early, so it
# doesn't depend on anything the web test-and-rebuild block below might
# stage -- but the actual echo/exit for it is deferred to the very end
# of the script (see "found" below), printed *after* that block's own
# vitest/Playwright/build output instead of before it. Tried printing it
# here first (the obvious order) and confirmed by hand that it's a real
# usability trap: vitest alone runs ~150 tests and Playwright's `uv run
# deckifyr serve` webServer logs every request, so an early reminder
# scrolls off well before the commit actually gets rejected, and it's
# easy to misread the final failure as coming from the test/build step
# that happened to run last instead of this one -- the exact "stale
# screenshots keep landing anyway" pattern issue #33 was filed over,
# now compounded by issue #41's own fix adding a wall of test output in
# between. Printing this reminder last -- as the actual final thing on
# screen before the hook exits -- is the fix, not a bigger detector.
found=0
screenshot_reminder=""

if [ -z "$SKIP_DOCS_ASSET_CHECK" ]; then
  assets_touched=$(printf '%s\n' "$staged" | grep -cE '^man/figures/demo-deck(-[a-z-]+\.png|\.pptx)$')

  check_group() {
    label="$1"
    pattern="$2"
    [ "$assets_touched" -gt 0 ] && return
    if printf '%s\n' "$staged" | grep -qE "$pattern"; then
      screenshot_reminder="${screenshot_reminder}pre-commit reminder: staged changes touch a source for $label
  (man/figures/demo-deck-*.png and demo-deck.pptx may now be stale -- see this hook's own header for the regeneration recipe)
"
      found=1
    fi
  }

  check_group "the demo-deck example" \
    '^examples/demo-deck/(design\.yaml|layouts\.yaml|presentation\.yaml|standard_footnotes\.yaml|assets/|OUTPUTS/)'

  check_group "the PPTX compositor/planner/resolvers demo-deck exercises" \
    '^inst/python/deckifyr/(schema/|plan\.py|pptx/|resolvers/)'

  # Separate asset group, separate "touched" check (deliberately not folded
  # into check_group()/assets_touched above -- those two are specifically
  # about the demo-deck PNG/PPTX group, and touching one must not silence a
  # reminder about this unrelated pair of web-editor screenshots).
  web_screenshots_touched=$(printf '%s\n' "$staged" | grep -cE '^man/figures/web-app-(editor|no-project|furniture|layout-tab|add-slide|add-element|build-preview|color-swatch)\.png$')
  if [ "$web_screenshots_touched" -eq 0 ] && printf '%s\n' "$staged" | grep -qE '^web/src/'; then
    screenshot_reminder="${screenshot_reminder}pre-commit reminder: staged changes touch the web editor's frontend source
  (man/figures/web-app-editor.png/web-app-no-project.png/web-app-furniture.png/web-app-layout-tab.png/web-app-add-slide.png/web-app-add-element.png/web-app-build-preview.png/web-app-color-swatch.png, used in vignettes/articles/web-app.Rmd, may now be stale -- see CONTRIBUTING.md for how to regenerate them)
"
    found=1
  fi
fi

# Third, separate check: inst/python/deckifyr/web/static/ is not a docs
# asset, it's the actual shipped frontend bundle -- the Python
# wheel/R package install it, and `deckifyr serve` serves it directly
# (CONTRIBUTING.md's "Rebuilding the web frontend" section documents the
# rule). This used to just hard-block and tell the human to rebuild by
# hand -- but nothing forced that to actually happen before committing,
# and nothing ran the frontend's own test suites either (issue #41:
# "no forcing functions for the static elements of the web app to be
# rebuilt at any step of development", so what got boxed up wasn't
# rigorously tested or necessarily the intended build). This block now
# runs the checks itself instead of asking for them -- vitest, a real
# Playwright e2e run against `deckifyr serve` (needs `uv`, mirroring
# test-wiring.R's/test_renderers_quarto.py's own "skip cleanly when the
# toolchain is absent" posture elsewhere in this repo), then
# `npm run build`, auto-staging whatever changed under
# inst/python/deckifyr/web/static/ -- so what lands in the commit is
# always the real output of a green build, not a promise that one was
# run by hand. Not gated behind SKIP_DOCS_ASSET_CHECK (that's for the
# separate rendered-doc-asset reminders above); use SKIP_WEB_CHECKS=1 or
# --no-verify instead.
if printf '%s\n' "$staged" | grep -qE '^web/(src/|package(-lock)?\.json)'; then
  if [ -n "$SKIP_WEB_CHECKS" ]; then
    echo "pre-commit: SKIP_WEB_CHECKS set -- not testing or rebuilding the web frontend" >&2
    echo "  (inst/python/deckifyr/web/static/ may now be stale -- see CONTRIBUTING.md)" >&2
  elif ! command -v npm >/dev/null 2>&1; then
    echo "pre-commit error: staged changes touch web/src/ (or web/'s package files) but" >&2
    echo "  npm isn't on PATH, so this hook can't test or rebuild the frontend bundle." >&2
    echo "  Install Node/npm, or bypass with SKIP_WEB_CHECKS=1 git commit ... (only if" >&2
    echo "  inst/python/deckifyr/web/static/ was already rebuilt by hand) or --no-verify." >&2
    exit 1
  else
    echo "pre-commit: staged web/ changes -- running vitest..." >&2
    if ! npm --prefix web test --silent; then
      echo "pre-commit error: web/'s vitest suite failed -- fix it, or bypass with" >&2
      echo "  SKIP_WEB_CHECKS=1 git commit ... / git commit --no-verify." >&2
      exit 1
    fi

    if command -v uv >/dev/null 2>&1; then
      echo "pre-commit: running Playwright e2e tests..." >&2
      if ! npm --prefix web run test:e2e --silent; then
        echo "pre-commit error: web/'s Playwright e2e suite failed -- fix it (a missing" >&2
        echo "  browser install is one cause: cd web && npx playwright install chromium)," >&2
        echo "  or bypass with SKIP_WEB_CHECKS=1 git commit ... / git commit --no-verify." >&2
        exit 1
      fi
    else
      echo "pre-commit: uv not on PATH -- skipping Playwright e2e (its webServer execs" >&2
      echo "  'uv run deckifyr serve'); vitest alone can't exercise real browser behavior." >&2
    fi

    echo "pre-commit: rebuilding inst/python/deckifyr/web/static/..." >&2
    if ! npm --prefix web run build --silent; then
      echo "pre-commit error: 'npm run build' failed -- the staged web/src/ changes don't" >&2
      echo "  compile. Fix the build, then re-stage and commit." >&2
      exit 1
    fi
    git add -A -- inst/python/deckifyr/web/static
  fi
fi

if [ "$found" = "1" ]; then
  echo "" >&2
  echo "==================================================================" >&2
  printf '%s' "$screenshot_reminder" >&2
  echo "If the change is purely cosmetic (comments, refactors with identical" >&2
  echo "composed output), commit anyway with SKIP_DOCS_ASSET_CHECK=1 git commit ..." >&2
  echo "or git commit --no-verify." >&2
  echo "==================================================================" >&2
  exit 1
fi

exit 0
