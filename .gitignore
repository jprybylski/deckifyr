# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Default `build.output`/`build.manifest` directory from presentation.yaml
# (spec section 7.6) -- regenerate with `deckifyr build`/`deck_build()`.
build/

# R
renv/library/
.Rproj.user/
.Rhistory

# testthat's own failure-snapshot artifacts from a local test_dir() run
tests/testthat/_problems/
tests/testthat/testthat-problems.rds

# Local tool downloads (quarto CLI tarball, etc.) - not part of the repo
.tools/

# web/ (spec section 12 frontend) - node_modules is a real install, not
# source; the Vite dev-server/vitest cache lives at node_modules/.vite,
# already covered by the line above. The *built* output at
# inst/python/deckifyr/web/static/ is committed (see web/vite.config.ts's
# own comment for why), so don't add a blanket ignore for that path here.
web/node_modules/

# OS
.DS_Store

# Personal Claude Code permissions/settings, not project source
.claude/

# pkgdown build output -- source lives in man/, README.md, _pkgdown.yml;
# docs/ itself is pure generated output (pkgdown's own default
# `destination:`), deployed via .github/workflows/pages.yml's
# upload-pages-artifact step, never committed.
docs/
