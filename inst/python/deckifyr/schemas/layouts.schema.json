{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "description": "Explicit geometry: origin top-left, +x right, +y down (spec section 7.3).\n\nFields keep their raw unit strings; `deckifyr.schema.units.parse_length`\nconverts them to EMUs during plan resolution, not here.",
      "properties": {
        "x": {
          "description": "Distance from the slide's left edge, with an explicit unit.",
          "title": "X",
          "type": "string",
          "x-deckifyr-widget": "length"
        },
        "y": {
          "description": "Distance from the slide's top edge, with an explicit unit.",
          "title": "Y",
          "type": "string",
          "x-deckifyr-widget": "length"
        },
        "width": {
          "description": "Box width with an explicit unit.",
          "title": "Width",
          "type": "string",
          "x-deckifyr-widget": "length"
        },
        "height": {
          "description": "Box height with an explicit unit.",
          "title": "Height",
          "type": "string",
          "x-deckifyr-widget": "length"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Box",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "description": "One element, as it appears in either a layout or a slide override.\n\n`id` is optional here because layouts.yaml and presentation.yaml's\ndict-keyed slide forms (spec section 7.6's `elements: {title: ...}`)\nuse the mapping key as the id; only the list-keyed freeform form\n(`elements: [{id: ..., ...}]`) sets it inline. Every field besides\n`type` is optional so an override can touch only what it changes,\nper the merge precedence in spec section 7.2.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Element id; only needed in list-form `elements`, where there is no mapping key.",
          "title": "Id"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "text",
                "markdown",
                "quarto",
                "image",
                "table",
                "shape",
                "group",
                "slot",
                "footnotes",
                "reportifyr"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What kind of element this is. Required once, then optional on overrides.",
          "title": "Type"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The element's content: text, Markdown, a magic string, or a path, depending on `type`.",
          "title": "Value"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File the element reads from, such as an image path or a table `.csv`/`.parquet`.",
          "title": "Source"
        },
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Position and size on the slide."
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rotation in degrees, clockwise, around the box centre.",
          "title": "Rotation"
        },
        "z_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stacking order; higher values paint on top.",
          "title": "Z Index"
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`text_styles` name controlling typography.",
          "title": "Style"
        },
        "center": {
          "default": false,
          "description": "Vertically centre text within the box.",
          "title": "Center",
          "type": "boolean"
        },
        "align": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Horizontal text alignment within the box.",
          "title": "Align"
        },
        "table_style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`table` only: `table_styles` name controlling fill and borders.",
          "title": "Table Style"
        },
        "fit": {
          "anyOf": [
            {
              "enum": [
                "contain",
                "cover",
                "stretch",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`image` only: how the picture fills its box.",
          "title": "Fit"
        },
        "overflow": {
          "anyOf": [
            {
              "enum": [
                "error",
                "shrink",
                "clip",
                "continue"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What to do when content does not fit the box.",
          "title": "Overflow"
        },
        "render_mode": {
          "anyOf": [
            {
              "enum": [
                "native",
                "svg",
                "png",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`quarto` only: how a fragment is rendered (native text, or a picture).",
          "title": "Render Mode"
        },
        "alt_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accessible description for pictures and shapes.",
          "title": "Alt Text"
        },
        "remove": {
          "default": false,
          "description": "On a slide override: drop this layout element from the slide.",
          "title": "Remove",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "description": "Fail the build if this element ends up without content.",
          "title": "Required",
          "type": "boolean"
        },
        "footer_placement": {
          "anyOf": [
            {
              "enum": [
                "below",
                "notes",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`reportifyr` and `{rpfy}:` tables: where the source/notes footer goes.",
          "title": "Footer Placement"
        },
        "shape_kind": {
          "anyOf": [
            {
              "enum": [
                "rectangle",
                "rounded_rectangle",
                "oval",
                "triangle",
                "diamond",
                "pentagon",
                "hexagon",
                "chevron",
                "right_arrow",
                "left_arrow",
                "up_arrow",
                "down_arrow",
                "star_5"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`shape` only: which autoshape to draw.",
          "title": "Shape Kind"
        },
        "elements": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/Element"
              },
              "type": "object"
            },
            {
              "items": {
                "$ref": "#/$defs/Element"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`group` only: child elements, keyed by id or listed with their own `id`.",
          "title": "Elements"
        }
      },
      "title": "Element",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "properties": {
        "elements": {
          "additionalProperties": {
            "$ref": "#/$defs/Element"
          },
          "default": {},
          "description": "The layout's named zones, keyed by id.",
          "title": "Elements",
          "type": "object"
        }
      },
      "title": "Layout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "deckifyr": {
      "description": "Schema version of this document.",
      "title": "Deckifyr",
      "type": "string"
    },
    "layouts": {
      "additionalProperties": {
        "$ref": "#/$defs/Layout"
      },
      "description": "Named layouts; a layout called `blank` is required.",
      "title": "Layouts",
      "type": "object"
    }
  },
  "required": [
    "deckifyr",
    "layouts"
  ],
  "title": "LayoutsDocument",
  "type": "object"
}
