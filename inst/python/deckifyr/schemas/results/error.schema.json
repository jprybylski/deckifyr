{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jprybylski/deckifyr/schemas/results/v1/error.schema.json",
  "$defs": {
    "DependencyEntry": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "install_url": {
          "title": "Install Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "display_name",
        "install_url"
      ],
      "title": "DependencyEntry",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "status": {
      "const": "error",
      "title": "Status",
      "type": "string"
    },
    "result_version": {
      "const": 1,
      "title": "Result Version",
      "type": "integer"
    },
    "code": {
      "description": "Stable error code (deckifyr.schema.errors.ErrorCode).",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "dependency": {
      "anyOf": [
        {
          "$ref": "#/$defs/DependencyEntry"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Present only for E_MISSING_DEPENDENCY."
    },
    "traceback": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Python traceback of an unexpected error (E_INTERNAL, or E_IO from an OS error); present only with --debug / DECKIFYR_DEBUG.",
      "title": "Traceback"
    }
  },
  "required": [
    "status",
    "result_version",
    "code",
    "message"
  ],
  "title": "ErrorResult",
  "type": "object"
}
