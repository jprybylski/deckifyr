{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jprybylski/deckifyr/schemas/results/v1/validate.schema.json",
  "$defs": {
    "WarningEntry": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "description": "Stable identifier for the kind of warning (e.g. W_MULTI_FIGURE).",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Human-readable text.",
          "title": "Message",
          "type": "string"
        },
        "slide": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Id of the slide it came from, or null for a build-level warning.",
          "title": "Slide"
        },
        "element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Id of the element it came from, or null.",
          "title": "Element"
        }
      },
      "required": [
        "code",
        "message",
        "slide",
        "element"
      ],
      "title": "WarningEntry",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "status": {
      "const": "ok",
      "title": "Status",
      "type": "string"
    },
    "result_version": {
      "const": 1,
      "title": "Result Version",
      "type": "integer"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "presentation": {
      "title": "Presentation",
      "type": "string"
    },
    "slide_count": {
      "title": "Slide Count",
      "type": "integer"
    },
    "layout_count": {
      "title": "Layout Count",
      "type": "integer"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "description": "Validation warnings. Empty unless `--warn-only` coerced something: each unitless box length is reported as W_UNITLESS_LENGTH.",
      "items": {
        "$ref": "#/$defs/WarningEntry"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "result_version",
    "valid",
    "presentation",
    "slide_count",
    "layout_count",
    "schema_version",
    "warnings"
  ],
  "title": "ValidateResult",
  "type": "object"
}
